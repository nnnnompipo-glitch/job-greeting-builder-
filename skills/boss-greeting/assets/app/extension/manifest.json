{
  "manifest_version": 3,
  "name": "求职招呼语助手（手动发送）",
  "version": "1.3.4",
  "minimum_chrome_version": "103",
  "description": "检测 BOSS、猎聘、智联当前岗位，结合个人资料和所选语气生成草稿，由你手动发送。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.zhipin.com/*", "https://www.liepin.com/*", "https://www.zhaopin.com/*", "https://jobs.zhaopin.com/*", "http://127.0.0.1:43127/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "求职招呼语助手" },
  "content_scripts": [{
    "matches": ["https://www.zhipin.com/*", "https://www.liepin.com/*", "https://www.zhaopin.com/*", "https://jobs.zhaopin.com/*"],
    "js": ["platforms.js", "extract.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
